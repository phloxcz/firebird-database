<?php

/**
 * Reflection and everything Nette does with it, on a real server.
 */

declare(strict_types=1);

use Nette\Caching\Storages\MemoryStorage;
use Nette\Database\Conventions\DiscoveredConventions;
use Nette\Database\DriverException;
use Nette\Database\Explorer;
use Nette\Database\ForeignKeyConstraintViolationException;
use Nette\Database\NotNullConstraintViolationException;
use Nette\Database\Structure;
use Nette\Database\UniqueConstraintViolationException;
use Tester\Assert;

require __DIR__ . '/bootstrap.php';

$connection = createConnection();
$driver = $connection->getDriver();
$pdo = $connection->getPdo();

dropTables($connection, 'V_BOOKS', 'BOOK_TAGS', 'BOOKS', 'TAGS', 'AUTHORS', 'PAIR_CHILD', 'PAIR_PARENT');

foreach ([
    "CREATE TABLE AUTHORS (ID INTEGER NOT NULL PRIMARY KEY, NAME VARCHAR(50) NOT NULL, COUNTRY CHAR(2) DEFAULT 'CZ', SALARY NUMERIC(9,2), RATE DECIMAL(5,1), SCORE DOUBLE PRECISION, ACTIVE BOOLEAN DEFAULT TRUE, BIO BLOB SUB_TYPE TEXT, BORN DATE, WAKES TIME, CREATED TIMESTAMP, BIG BIGINT, TINY SMALLINT, REAL_F FLOAT)",
    'CREATE TABLE BOOKS (ID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, AUTHOR_ID INTEGER NOT NULL REFERENCES AUTHORS(ID), TITLE VARCHAR(100) NOT NULL UNIQUE)',
    'CREATE TABLE TAGS (ID INTEGER NOT NULL PRIMARY KEY, NAME VARCHAR(20))',
    'CREATE TABLE BOOK_TAGS (BOOK_ID INTEGER NOT NULL REFERENCES BOOKS(ID), TAG_ID INTEGER NOT NULL REFERENCES TAGS(ID), PRIMARY KEY (BOOK_ID, TAG_ID))',
    'CREATE TABLE PAIR_PARENT (A INTEGER NOT NULL, B INTEGER NOT NULL, PRIMARY KEY (A, B))',
    'CREATE TABLE PAIR_CHILD (ID INTEGER NOT NULL PRIMARY KEY, PA INTEGER, PB INTEGER, FOREIGN KEY (PA, PB) REFERENCES PAIR_PARENT(A, B))',
    'CREATE VIEW V_BOOKS AS SELECT ID, TITLE FROM BOOKS',
    'CREATE INDEX IDX_BOOK_TITLE_AUTHOR ON BOOKS (TITLE, AUTHOR_ID)',
    "COMMENT ON TABLE AUTHORS IS 'People who write'",
    "COMMENT ON COLUMN AUTHORS.NAME IS 'Full name'",
] as $sql) {
    $pdo->exec($sql);
}

// --- Tables

$tables = array_column($driver->getTables(), null, 'name');
Assert::true(isset($tables['AUTHORS'], $tables['BOOKS'], $tables['V_BOOKS']));
Assert::false($tables['AUTHORS']['view']);
Assert::true($tables['V_BOOKS']['view']);
Assert::same('People who write', $tables['AUTHORS']['comment']);
Assert::null($tables['BOOKS']['comment']);
Assert::false(isset($tables['RDB$RELATIONS']), 'no system tables');

// --- Columns

$columns = array_column($driver->getColumns('AUTHORS'), null, 'name');
Assert::same(
    ['ID', 'NAME', 'COUNTRY', 'SALARY', 'RATE', 'SCORE', 'ACTIVE', 'BIO', 'BORN', 'WAKES', 'CREATED', 'BIG', 'TINY', 'REAL_F'],
    array_keys($columns),
    'in the order of the table',
);
Assert::same(
    ['INTEGER', 'VARCHAR', 'CHAR', 'NUMERIC', 'DECIMAL', 'DOUBLE PRECISION', 'BOOLEAN', 'BLOB', 'DATE', 'TIME', 'TIMESTAMP', 'BIGINT', 'SMALLINT', 'FLOAT'],
    array_column($columns, 'nativetype'),
    'as they were declared',
);
Assert::same('AUTHORS', $columns['ID']['table']);
Assert::true($columns['ID']['primary']);
Assert::false($columns['NAME']['primary']);
Assert::false($columns['ID']['nullable']);
Assert::false($columns['NAME']['nullable']);
Assert::true($columns['COUNTRY']['nullable']);
Assert::same(50, $columns['NAME']['size'], 'characters, not bytes');
Assert::same(2, $columns['COUNTRY']['size']);
Assert::same('CZ', $columns['COUNTRY']['default']);
Assert::same('TRUE', $columns['ACTIVE']['default']);
Assert::null($columns['NAME']['default']);
Assert::false($columns['ID']['autoincrement']);
Assert::same('Full name', $columns['NAME']['comment']);
Assert::null($columns['ID']['comment']);
Assert::same(-2, (int) $columns['SALARY']['vendor']['FIELD_SCALE']);

$identity = array_column($driver->getColumns('BOOKS'), null, 'name')['ID'];
Assert::false($identity['autoincrement'], 'Nette would ask PDO for the last ID, which it can not tell');
Assert::notSame(null, $identity['vendor']['IDENTITY_TYPE'], 'an identity column can be told');
Assert::null($columns['ID']['vendor']['IDENTITY_TYPE']);
Assert::same(['ID', 'TITLE'], array_column($driver->getColumns('V_BOOKS'), 'name'), 'a view too');
Assert::same([], $driver->getColumns('NOTHING'));

$both = array_column($driver->getColumns('BOOK_TAGS'), 'primary', 'name');
Assert::same(['BOOK_ID' => true, 'TAG_ID' => true], $both, 'a composite key');

// --- Indexes

$indexes = array_column($driver->getIndexes('BOOKS'), null, 'name');
Assert::same(['TITLE', 'AUTHOR_ID'], $indexes['IDX_BOOK_TITLE_AUTHOR']['columns'], 'in their order');
Assert::false($indexes['IDX_BOOK_TITLE_AUTHOR']['unique']);
Assert::false($indexes['IDX_BOOK_TITLE_AUTHOR']['primary']);

$primary = array_values(array_filter($driver->getIndexes('BOOK_TAGS'), static fn(array $index): bool => $index['primary']));
Assert::count(1, $primary);
Assert::true($primary[0]['unique']);
Assert::same(['BOOK_ID', 'TAG_ID'], $primary[0]['columns']);

// --- Foreign keys

$keys = $driver->getForeignKeys('BOOKS');
Assert::count(1, $keys);
Assert::same(['AUTHOR_ID', 'AUTHORS', 'ID'], [$keys[0]['local'], $keys[0]['table'], $keys[0]['foreign']]);

Assert::count(2, $driver->getForeignKeys('BOOK_TAGS'));

$composite = $driver->getForeignKeys('PAIR_CHILD');
Assert::same([['PA', 'A'], ['PB', 'B']], array_map(static fn(array $key): array => [$key['local'], $key['foreign']], $composite), 'columns of a composite key pair up');
Assert::same([], $driver->getForeignKeys('TAGS'));

// --- Explorer

$storage = new MemoryStorage();
$structure = new Structure($connection, $storage);
$explorer = new Explorer($connection, $structure, new DiscoveredConventions($structure), $storage);

Assert::same('ID', $structure->getPrimaryKey('AUTHORS'));
Assert::same(['BOOK_ID', 'TAG_ID'], $structure->getPrimaryKey('BOOK_TAGS'));

$explorer->table('AUTHORS')->insert(['ID' => 1, 'NAME' => 'Ann', 'SALARY' => 10.5, 'BORN' => new DateTimeImmutable('2000-01-02'), 'ACTIVE' => true]);
$explorer->table('AUTHORS')->insert(['ID' => 2, 'NAME' => "O'Neil 100%", 'ACTIVE' => false]);
$explorer->table('AUTHORS')->insert(['ID' => 3, 'NAME' => 'C_x']);
$explorer->table('TAGS')->insert(['ID' => 1, 'NAME' => 'a']);
$explorer->table('TAGS')->insert(['ID' => 2, 'NAME' => 'b']);

// Firebird has no multi-row VALUES, and what Nette writes instead needs a FROM
Assert::exception(static fn() => $explorer->table('TAGS')->insert([['ID' => 3, 'NAME' => 'c'], ['ID' => 4, 'NAME' => 'd']]), DriverException::class);

Assert::same(3, $explorer->table('AUTHORS')->count('*'));
Assert::same('Ann', $explorer->table('AUTHORS')->get(1)->NAME);
Assert::same(10.5, $explorer->table('AUTHORS')->get(1)->SALARY);
Assert::same('2000-01-02', $explorer->table('AUTHORS')->get(1)->BORN->format('Y-m-d'));
Assert::true($explorer->table('AUTHORS')->get(1)->ACTIVE);
Assert::same('CZ', trim($explorer->table('AUTHORS')->get(1)->COUNTRY), 'a default');
Assert::same(1, $explorer->table('AUTHORS')->where('ACTIVE', true)->where('ID', 1)->count('*'), 'BOOLEAN as a parameter');
Assert::same(1, $explorer->table('AUTHORS')->where('ACTIVE', false)->count('*'));

Assert::same([1, 2], array_keys($explorer->table('AUTHORS')->order('ID')->limit(2)->fetchPairs('ID', 'ID')));
Assert::same([2, 3], array_keys($explorer->table('AUTHORS')->order('ID')->limit(2, 1)->fetchPairs('ID', 'ID')));
Assert::same([3], array_keys($explorer->table('AUTHORS')->order('ID')->page(2, 2)->fetchPairs('ID', 'ID')));

// An insert with an identity column gets its row back only with the key given
Assert::same('One', $explorer->table('BOOKS')->insert(['ID' => 10, 'AUTHOR_ID' => 1, 'TITLE' => 'One'])->TITLE);

// Without it, the number of rows, and the key through RETURNING
Assert::same(1, $explorer->table('BOOKS')->insert(['AUTHOR_ID' => 3, 'TITLE' => 'Generated']));
$generated = $connection->fetchField('INSERT INTO BOOKS (AUTHOR_ID, TITLE) VALUES (?, ?) RETURNING ID', 3, 'Generated 2');
Assert::type('int', $generated);
Assert::same('Generated 2', $connection->fetchField('SELECT TITLE FROM BOOKS WHERE ID = ?', $generated));
$connection->query('DELETE FROM BOOKS WHERE AUTHOR_ID = 3');

$explorer->table('BOOKS')->insert(['ID' => 11, 'AUTHOR_ID' => 1, 'TITLE' => 'Two']);
$explorer->table('BOOKS')->insert(['ID' => 12, 'AUTHOR_ID' => 2, 'TITLE' => 'Three']);

// References, both ways
Assert::same('Ann', $explorer->table('BOOKS')->get(10)->ref('AUTHORS', 'AUTHOR_ID')->NAME);
Assert::same('Ann', $explorer->table('BOOKS')->get(10)->AUTHOR->NAME, 'by the column');
Assert::same([10, 11], array_keys($explorer->table('AUTHORS')->get(1)->related('BOOKS', 'AUTHOR_ID')->order('ID')->fetchPairs('ID', 'ID')));
Assert::same(2, $explorer->table('AUTHORS')->get(1)->related('BOOKS', 'AUTHOR_ID')->count('*'));

// More parents at once, and a limit that Nette handles itself
$titles = [];
foreach ($explorer->table('AUTHORS')->order('ID') as $author) {
    $titles[$author->ID] = array_values($author->related('BOOKS', 'AUTHOR_ID')->order('ID')->limit(1)->fetchPairs('ID', 'TITLE'));
}
Assert::same([1 => ['One'], 2 => ['Three'], 3 => []], $titles);

// Joins of Nette through a column and through a table
Assert::same(2, $explorer->table('BOOKS')->where('AUTHOR.NAME', 'Ann')->count('*'));
Assert::same(2, $explorer->table('AUTHORS')->where(':BOOKS.TITLE', ['One', 'Three'])->count('*'));

// Grouping refuses columns which aren't grouped
$grouped = $explorer->table('BOOKS')->select('AUTHOR_ID, COUNT(*) AS CNT')->group('AUTHOR_ID')->order('AUTHOR_ID')->fetchPairs('AUTHOR_ID', 'CNT');
Assert::same([1 => 2, 2 => 1], $grouped);

// A composite key
$explorer->table('BOOK_TAGS')->insert(['BOOK_ID' => 10, 'TAG_ID' => 1]);
$explorer->table('BOOK_TAGS')->insert(['BOOK_ID' => 10, 'TAG_ID' => 2]);
Assert::same(1, $explorer->table('BOOK_TAGS')->wherePrimary(['BOOK_ID' => 10, 'TAG_ID' => 2])->count('*'));

// Update and delete
Assert::same(1, $explorer->table('AUTHORS')->where('ID', 3)->update(['NAME' => 'Cyril']));
Assert::same('Cyril', $explorer->table('AUTHORS')->get(3)->NAME);
Assert::same(0, $explorer->table('TAGS')->where('ID', 99)->update(['NAME' => 'x']));
$row = $explorer->table('AUTHORS')->get(3);
Assert::true($row->update(['NAME' => 'C_x']));
Assert::same('C_x', $explorer->table('AUTHORS')->get(3)->NAME);

// A subquery from another selection
Assert::same(2, $explorer->table('AUTHORS')->where('ID', $explorer->table('BOOKS')->select('AUTHOR_ID'))->count('*'));

// A LIKE built by the driver
$like = static fn(string $value, int $position): array => array_keys($explorer->table('AUTHORS')->where('NAME LIKE ?', new Nette\Database\SqlLiteral($driver->formatLike($value, $position)))->order('ID')->fetchPairs('ID', 'ID'));
Assert::same([2], $like('100%', -1), 'a percent sign is one');
Assert::same([3], $like('C_', 1), 'an underscore is one');
Assert::same([], $like('Cx', 1));
Assert::same([2], $like("O'N", 1), 'a quote too');

// --- Parameters and a transaction

Assert::same('Ann', $connection->fetchField('SELECT NAME FROM AUTHORS WHERE ID = ?', 1));
Assert::same('Ann', $connection->fetchField('SELECT NAME FROM AUTHORS WHERE BORN = ?', new DateTimeImmutable('2000-01-02')));

$connection->beginTransaction();
$connection->query('UPDATE AUTHORS SET NAME = ? WHERE ID = 1', 'Changed');
$connection->rollBack();
Assert::same('Ann', $connection->fetchField('SELECT NAME FROM AUTHORS WHERE ID = 1'));

// --- Errors

Assert::exception(static fn() => $connection->query('INSERT INTO AUTHORS (ID, NAME) VALUES (1, ?)', 'x'), UniqueConstraintViolationException::class);
Assert::exception(static fn() => $connection->query("INSERT INTO BOOKS (ID, AUTHOR_ID, TITLE) VALUES (99, 1, 'One')"), UniqueConstraintViolationException::class, null);
Assert::exception(static fn() => $connection->query("INSERT INTO BOOKS (ID, AUTHOR_ID, TITLE) VALUES (99, 999, 'x')"), ForeignKeyConstraintViolationException::class);
Assert::exception(static fn() => $connection->query('INSERT INTO AUTHORS (ID) VALUES (50)'), NotNullConstraintViolationException::class);
$syntax = Assert::exception(static fn() => $connection->query('SELECT nonsense FROM AUTHORS'), DriverException::class);
Assert::same(DriverException::class, $syntax::class);

dropTables($connection, 'V_BOOKS', 'BOOK_TAGS', 'BOOKS', 'TAGS', 'AUTHORS', 'PAIR_CHILD', 'PAIR_PARENT');
